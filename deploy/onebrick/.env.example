# Copy to /srv/hive/secrets/hive.env, chmod 0600, and replace every CHANGE_ME.
# Never commit the resulting file.
HIVE_IMAGE=ghcr.io/bricko-brick/hive@sha256:CHANGE_ME_RELAY_IMAGE_DIGEST
HIVE_AGENT_IMAGE=ghcr.io/bricko-brick/hive-agent@sha256:CHANGE_ME_AGENT_IMAGE_DIGEST
HIVE_HTTP_BIND=127.0.0.1:3300
ONEBRICK_INGRESS_NETWORK=onebrick-stack_private_net
HIVE_DOMAIN=hive.onebrick.io
RELAY_URL=wss://hive.onebrick.io
BUZZ_MEDIA_BASE_URL=https://hive.onebrick.io/media
BUZZ_MEDIA_SERVER_DOMAIN=hive.onebrick.io
BUZZ_CORS_ORIGINS=https://hive.onebrick.io

BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=false
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

RELAY_OWNER_PUBKEY=CHANGE_ME_64_HEX_OWNER_PUBKEY
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_RELAY_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=hive
POSTGRES_USER=hive
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=hive-media

BRICKO_PRIVATE_KEY=CHANGE_ME_64_HEX_BRICKO_PRIVATE_KEY
BUZZ_ACP_AGENT_COMMAND=codex-acp
BUZZ_ACP_AGENT_ARGS=
BUZZ_ACP_AGENTS=1
BUZZ_ACP_LAZY_POOL=true
BUZZ_ACP_SESSION_POLICY=thread
BUZZ_ACP_RESPOND_TO=owner-only
BUZZ_ACP_HEARTBEAT_INTERVAL=0
BUZZ_ACP_IDLE_TIMEOUT=620
BUZZ_ACP_MAX_TURN_DURATION=7200

HIVE_CODEX_HOME=/srv/hive/secrets/codex-home
HIVE_AGENT_WORKSPACE=/srv/hive/agent-workspaces
HIVE_BACKUP_ROOT=/srv/hive/backups
