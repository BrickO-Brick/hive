hive.onebrick.io {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), usb=()"
		-Server
	}

	# Human visitors should enter the web client. Nostr relay clients do not
	# advertise HTML and continue to receive the NIP-11 document at `/`.
	@hiveBrowserRoot {
		path /
		header Accept *text/html*
	}
	redir @hiveBrowserRoot /app 302

	# Stable human-facing entry point for macOS and Windows installers. The
	# release metadata and signed updater manifest remain immutable on GitHub;
	# the SPA resolves the newest stable desktop-v* release.
	redir /downloads /download 308

	request_body {
		max_size 100MB
	}

	reverse_proxy hive-relay:3000 {
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}
